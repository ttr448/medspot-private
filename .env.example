# Copy this file to .env and replace the example values.
SECRET_KEY=replace-with-a-local-django-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=medspot_db
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=localhost
DB_PORT=3306

# Google Maps JavaScript API + Routes API key for maps and in-app driving routes.
# Enable both APIs and billing in Google Cloud; restrict the key to your website.
GOOGLE_MAPS_API_KEY=
